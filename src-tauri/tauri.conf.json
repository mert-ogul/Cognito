{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "cognito",
  "version": "0.1.0",
  "identifier": "com.mertogul.cognito",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build && npm run package:sidecar",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Cognito",
        "width": 1280,
        "height": 800,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": [
      "resources/sidecar"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
